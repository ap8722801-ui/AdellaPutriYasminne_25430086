erDiagram
    dosen {
        string PK_id_dosen "PK | id_dosen | SMALLINT | AI"
        string col2 "   | nip_dosen | CHAR(15) | UNIQUE"
        string col3 "   | nama_dosen | VARCHAR(100) | NOT NULL"
        string col4 "   | no_hp_dosen | VARCHAR(15) | NULL"
    }

    matakuliah {
        string PK_id_mk "PK | id_mk | INT | AI"
        string col2 "   | kode_mk | VARCHAR(10) | UNIQUE"
        string col3 "   | nama_mk | VARCHAR(100) | NOT NULL"
        string col4 "   | sks | TINYINT | NOT NULL"
    }

    mahasiswa {
        string PK_id_mhs "PK | id_mahasiswa | INT | AI"
        string col2 "   | nim | VARCHAR(15) | UNIQUE"
        string col3 "   | nama_mahasiswa | VARCHAR(100) | NOT NULL"
        string FK_id_dosen "FK | id_dosen | SMALLINT | → dosen"
        string col5 "   | email | VARCHAR(100) | NULL"
    }

    krs {
        string PK_id_krs "PK | id_krs | INT | AI"
        string col2 "   | semester | VARCHAR(10) | NOT NULL"
        string FK_id_mhs "FK | id_mahasiswa | INT | → mahasiswa"
        string col4 "   | status_approval | VARCHAR(20) | Pending"
    }

    detail_krs {
        string PKFK_id_krs "PK, FK | id_krs | INT | → krs"
        string PKFK_id_mk "PK, FK | id_mk | INT | → matakuliah"
    }

    pembayaran {
        string PK_id_bayar "PK | id_pembayaran | INT | AI"
        string col2 "   | no_kuitansi | VARCHAR(20) | UNIQUE"
        string FK_id_mhs "FK | id_mahasiswa | INT | → mahasiswa"
        string col4 "   | nominal_spp | DECIMAL(10,2) | NOT NULL"
        string col5 "   | denda | DECIMAL(10,2) | DEFAULT 0"
        string col6 "   | tanggal_bayar | DATE | NOT NULL"
    }

    dosen ||--o{ mahasiswa : "membimbing"
    mahasiswa ||--o{ krs : "mengajukan"
    mahasiswa ||--o{ pembayaran : "melakukan"
    krs ||--o{ detail_krs : "memuat"
    matakuliah ||--o{ detail_krs : "tercantum_di"
